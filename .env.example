# Copy this file to ".env" at the project root and fill with real values (do NOT commit .env).

# Firebase (required for frontend auth/storage)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DB_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Optional OpenAI key (used by backend if present)
OPENAI_API_KEY=

# Model path used by backend (relative to repo)
MODEL_PATH=backend/model.h5

# Optional: path to Firebase service account JSON if you use Admin SDK (backend only)
# FIREBASE_SERVICE_ACCOUNT=backend/firebase_admin.json
